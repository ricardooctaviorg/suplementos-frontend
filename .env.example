# Copy this file to .env.local. .env.local is never committed.

# Backend URL. Locally: the suplementos-backend API.
# On Railway: use the backend service's internal (private network) URL.
# Must also be available at build time (rewrites are fixed at compile time).
BACKEND_URL=http://localhost:3001

# Secret shared with the backend for catalog revalidation
REVALIDATE_SECRET=
