# Copia este archivo a .env.local. .env.local nunca se versiona.

# URL del backend. En local: el API de suplementos-backend.
# En Railway: usa la URL interna (red privada) del servicio backend.
# Debe estar disponible también en build (los rewrites se fijan al compilar).
BACKEND_URL=http://localhost:3001

# Secreto compartido con el backend para la revalidación del catálogo
REVALIDATE_SECRET=
